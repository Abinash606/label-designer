{% comment %}
  Label Designer Button Block
{% endcomment %}

<!-- BUTTON -->
<div class="label-designer-launch">
  <button
    type="button"
    class="btn btn-primary btn-lg"
    id="openLabelDesigner"
  >
    Customize Label
  </button>
</div>

<!-- DESIGNER (HIDDEN INITIALLY) -->
<div
  id="labelDesignerContainer"
  style="display:none;"
>
  {% render 'designer-html' %}
</div>

{{ 'designer.css' | asset_url | stylesheet_tag }}
{{ 'designer.js' | asset_url | script_tag }}

<!-- External libraries -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/6.0.0/fabric.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" defer></script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    window.LabelDesigner?.init({
      productId: {{ product.id }},
      variantId: {{ product.selected_or_first_available_variant.id }},
      title: {{ product.title | json }},
      price: {{ product.price | money_without_currency | json }}
    });
  });
</script>

{% schema %}
{
  "name": "Label Designer Button",
  "target": "section",
  "templates": ["product"],
  "settings": []
}
{% endschema %}
